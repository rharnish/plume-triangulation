# Data — 13 GB of FIgLib archives, fetched not committed. See data/README.md
data/tgz/
data/frames/
data/cache/
# HPWREN CDN frames: star-calibration nights (stars/nights.py) and extra cameras for
# recent fires (recent.py). Their manifests live in out/sky/ and data/meta/recent/.
data/hpwren_nights/
data/hpwren_recent/

# Derived outputs (scoped, not blanket — a blanket *.png would silently
# swallow committed figures and web assets)
out/
data/**/*.png
data/**/*.jpg
data/**/*.mp4
data/**/*.parquet

# Python
.venv/
.venv-train/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local Claude Code settings (machine paths, not for publication)
.claude/settings.local.json

# Model weights, fetched not committed (see models/README.md)
models/*.onnx
models/*.pt
models/*.mlpackage

# Copernicus DEM tiles, fetched not committed
data/dem/

# Coverage map viewer, local work in progress
src/figlib/coverage_map/

# pyro-sdis training data (3.3 GB), fetched not committed
data/sdis/

# Trained and pretrained scale-comparison weights, fetched/produced not committed
models/scale/
# ultralytics' AMP self-check downloads yolo26n.pt into ./weights/ on every training start
weights/

# Reference papers, kept locally for citation checking, not redistributed
docs/reference/
